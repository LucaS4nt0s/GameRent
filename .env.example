# Modelo do arquivo .env usado no deploy na EC2 (copie para /opt/gamerent/.env e preencha).
# O .env de verdade NUNCA vai para o Git (está no .gitignore). Guia completo: infra/README.md.
#
#   cp .env.example .env && nano .env
#   docker compose -f docker-compose.yml -f docker-compose.aws.yml up -d --build

# ---------- AWS ----------
AWS_REGION=sa-east-1

# ---------- Login com Amazon Cognito (obrigatório no docker-compose.aws.yml) ----------
# User pool ID e App client público (sem secret), região sa-east-1
COGNITO_USER_POOL_ID=sa-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=
# Domínio do Hosted UI, sem https:// (ex.: jogai-gamerent.auth.sa-east-1.amazoncognito.com)
VITE_COGNITO_DOMAIN=
# Endereço público do site com a barra final. Fora de localhost o Cognito exige https,
# por isso use o domínio do CloudFront (ex.: https://dxxxxxxxxxxxx.cloudfront.net/).
# O mesmo valor precisa estar em "Allowed callback URLs" e "Allowed sign-out URLs" do App client.
VITE_COGNITO_REDIRECT_URI=https://dxxxxxxxxxxxx.cloudfront.net/

# ---------- Segredos internos (gere com: openssl rand -hex 32) ----------
# Rotas internas rental-service -> catalog-service (/reserve e /release)
SERVICE_TOKEN=
# Liberação forçada de jogo pelo admin (header X-Admin-Token)
ADMIN_TOKEN=

# ---------- Rede ----------
# Como o rental-service encontra o catálogo. Padrão: nome do Route 53 (rode infra/setup_route53.sh).
# Sem a zona privada criada, descomente para usar o DNS interno do Docker:
# CATALOG_SERVICE_URL=http://catalog-service:8001
# Origens que podem chamar a API pelo navegador (o endereço público do site)
CORS_ORIGINS=https://dxxxxxxxxxxxx.cloudfront.net
# Porta do site na EC2. Atrás do CloudFront use 80 (origem HTTP padrão); acesso direto: 8080
FRONTEND_PORT=80
